# Copy to .env on the deployment host. Contains no secrets — those live in
# deploy/secrets/, are generated on first deploy, and are never committed.

ATHENA_TAG=dev
ATHENA_ENVIRONMENT=production
ATHENA_LOG_LEVEL=INFO
ATHENA_WORKER_CONCURRENCY=4
ATHENA_APP_NAME=Athena

# Bind the dashboard to loopback by default. On a Tailscale host, set this to the
# tailnet IP so it is reachable over the tailnet and nowhere else.
#   ATHENA_WEB_BIND=100.118.7.119
# Node channel. Loopback by default so an agent on this host can enrol and poll.
# Widen only deliberately, and put TLS in front when you do.
ATHENA_API_BIND=127.0.0.1
ATHENA_API_PORT=8000

# Read-only Docker API for the node agent, so it can inventory containers without
# being granted docker group membership (which is root-equivalent). Loopback only.
ATHENA_DOCKER_PROXY_BIND=127.0.0.1
ATHENA_DOCKER_PROXY_PORT=2375

ATHENA_WEB_BIND=127.0.0.1
ATHENA_WEB_PORT=8080

# Group that owns /var/run/docker.sock, so the worker can launch sandboxed scanner
# containers. 0 on Docker Desktop; on a Linux host run:
#   stat -c %g /var/run/docker.sock
DOCKER_SOCKET_GID=65534

# Group that owns deploy/secrets/. Compose bind-mounts file secrets with their host
# ownership, so containers must join this group to read them. gen-secrets.sh fills
# this in from the deploying user's primary group.
ATHENA_SECRET_GID=0
# These two must differ: Compose rejects duplicate group_add entries.

# --- HTTPS -------------------------------------------------------------------
# Session cookies carry the Secure flag, so browsers only send them over HTTPS.
# Serving the dashboard over plain HTTP breaks login.
#
# On a Tailscale host the clean answer is to let Tailscale terminate TLS:
#
#     sudo tailscale cert "$(tailscale status --json | jq -r .Self.DNSName | sed 's/\.$//')"
#     sudo tailscale serve --bg --https=443 http://127.0.0.1:8080
#
# Then leave ATHENA_WEB_BIND at 127.0.0.1 and reach the dashboard at
# https://<host>.<tailnet>.ts.net — no port published to the tailnet at all.
#
# Only if you accept plain HTTP on a trusted network, and understand that session
# cookies then travel unencrypted:
# ATHENA_COOKIE_SECURE=false
